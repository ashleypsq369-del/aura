# ============================================================
# Project Aura Frontend - Vercel Environment Variables
# ============================================================
# Add this in Vercel → Project Settings → Environment Variables
# Set environment to: Production

# Your Koyeb backend URL (no trailing slash)
# Find this in Koyeb dashboard after deploying the backend
VITE_API_URL=https://project-aura-api-YOUR_KOYEB_ID.koyeb.app
