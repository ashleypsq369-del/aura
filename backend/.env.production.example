# ============================================================
# Project Aura - Production Environment Variables for Koyeb
# ============================================================
# Copy these into Koyeb's "Environment variables" settings page.
# DO NOT commit the real values to git.

# --- Database (Neon PostgreSQL - free tier) ---
# Get this from: https://console.neon.tech → your project → Connection string
# Use the "pooled" connection string for better performance
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Security ---
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_KEY_HERE

# --- CORS: Your Vercel frontend URL ---
# Format: https://your-app-name.vercel.app
# If you have a custom domain, add it too (comma separated, no spaces):
# ALLOWED_ORIGINS=https://project-aura.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=https://YOUR_APP_NAME.vercel.app

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- API Keys (optional - only if you want AI chat features) ---
# These are optional — the app works without them, AI chat just won't use LLMs
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- SendGrid / Twilio (optional - for email/SMS notifications) ---
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
