# ProjectAura Backend — Environment Variables
# ============================================================
# DATABASE: Uses PostgreSQL if available, falls back to SQLite.
# On your development machine (PostgreSQL running locally):
#   Set DATABASE_URL to the PostgreSQL connection string below.
# When sharing with others (no PostgreSQL installed):
#   Set DATABASE_URL to: sqlite:///aura.db
# ============================================================

# --- Database — CHOOSE ONE ---------------------------------------------------
# Option A: PostgreSQL (production, recommended for your own machine)
DATABASE_URL=postgresql://aura_user:vtVK7WlG1NQPIzqUaGclXIEP5iX6FfFq@localhost:5432/aura

# Option B: SQLite (zero-install, for sharing/demo on other machines)
# DATABASE_URL=sqlite:///aura.db

# --- Auth (JWT) ---------------------------------------------------------------
SECRET_KEY=a3f8e2d1c4b7a0f9e6d3c8b5a2f7e4d1c9b6a3f0e7d4c1b8a5f2e9d6c3b0a7
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI / LLM (optional — AI chat works offline without these) ----------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Optional integrations (leave blank to disable) --------------------------
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FROM_EMAIL=noreply@projectaura.gh

