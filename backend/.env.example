# ProjectAura Backend — Environment Variables TEMPLATE
# ============================================================
# COPY THIS FILE to .env and fill in your own values.
# NEVER commit .env to git — it is in .gitignore.
# ============================================================

# --- Database ---
# SQLite (zero-install, for local/demo use)
DATABASE_URL=sqlite:///aura.db

# PostgreSQL (production — use Neon free tier)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth (JWT) ---------------------------------------------------------------
# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_HOURS=8

# --- AI / LLM (optional) -----------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- Notifications (optional) -------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FROM_EMAIL=noreply@projectaura.gh

# --- Web Push VAPID (generate your own) ---------------------------------------
# Generate: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key, v.private_key)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@projectaura.gh

# --- CORS ---------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- App ----------------------------------------------------------------------
DEBUG=False
ENVIRONMENT=development
