# Dependencies
node_modules/
frontend/node_modules/
backend/venv/
backend/__pycache__/
**/__pycache__/
**/*.pyc
**/*.pyo

# Build output — exclude from git, built by CI/CD on each platform
frontend/dist/
frontend/build/
frontend/.vite/

# Database — include aura.db so recipients have demo data immediately
# (no PostgreSQL setup needed)
# Uncomment below only if you want to exclude it:
# backend/aura.db
# backend/*.db

# Environment files — .env is safe to share (no secrets, SQLite only)
# Only ignore local overrides
.env.local
.env.*.local
# backend/.env is intentionally tracked — pre-configured for standalone use
# Production env examples are tracked (they contain no real secrets)
# backend/.env.production is NOT tracked — add real secrets there
backend/.env.production

# Compiled executables & binaries
ace.exe
*.exe
*.bat
ace.spec
dist/

# Large binary assets (use CDN or LFS instead)
frontend/public/resources/slideshow/
frontend/public/resources/african/
frontend/public/icons/
build/

# ML model files — kept in .gitignore as they're large (>50MB total)
# Recipient can retrain with: cd backend/ml_training && python train_models_now.py
backend/ml_models/*.pkl
backend/ml_models/*.joblib
# The actual trained models in ml_training/models/ are tracked (needed for predictions)

# ============================================================
# SECURITY: NEVER commit real .env files
# ============================================================
backend/.env
.env
.env.production
frontend/.env.local
frontend/.env.production

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Backup folder
frontend_old_backup/
